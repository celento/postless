{
  "name": "postless-tui",
  "version": "0.1.0",
  "description": "A fast, local-first terminal HTTP client",
  "type": "module",
  "bin": {
    "postless": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.tsx",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "prepublishOnly": "npm run test && npm run build"
  },
  "license": "MIT",
  "dependencies": {
    "diff": "^8.0.2",
    "ink": "^5.2.1",
    "react": "^18.3.1",
    "shell-quote": "^1.8.3",
    "undici": "^7.16.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/diff": "^7.0.2",
    "@types/node": "^22.19.1",
    "@types/react": "^18.3.27",
    "@types/shell-quote": "^1.7.5",
    "esbuild": "^0.27.0",
    "eslint": "^9.39.1",
    "ink-testing-library": "^4.0.0",
    "tsup": "^8.5.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.47.0",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "esbuild": "^0.27.0"
  },
  "keywords": [
    "http",
    "cli",
    "tui",
    "api",
    "terminal",
    "postman"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/celento/postless.git"
  },
  "homepage": "https://github.com/celento/postless#readme",
  "bugs": {
    "url": "https://github.com/celento/postless/issues"
  }
}
